# ─── Observatório de Gastos Públicos — Environment Variables ─────────────────
# Copie este arquivo para .env e ajuste os valores

# ── Aplicação ─────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
APP_PORT=3000          # Porta exposta pelo Docker para acesso externo
LOG_LEVEL=info         # debug | info | warn | error

# ── Banco de Dados ────────────────────────────────────────────────────────────
POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio123
DB_PORT=5433           # Porta exposta localmente pelo Docker (evita conflito com postgres local)

# URL completa (usada pelo Prisma dentro do container Docker)
DATABASE_URL=postgresql://observatorio:observatorio123@db:5432/observatorio

# Para desenvolvimento local (fora do Docker):
# DATABASE_URL=postgresql://observatorio:observatorio123@localhost:5433/observatorio

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*
# Para produção, especifique o domínio:
# CORS_ORIGIN=https://meusite.com.br

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Apenas para desenvolvimento local (não necessário no Docker)
VITE_API_URL=/api
