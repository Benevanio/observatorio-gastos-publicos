NODE_ENV=production
LOG_LEVEL=info

FRONTEND_PORT=3000
BACKEND_PORT=3001

POSTGRES_DB=observatorio
POSTGRES_USER=observatorio
POSTGRES_PASSWORD=observatorio123
DB_PORT=5433

REDIS_PORT=6379
REDIS_ENABLED=true

CORS_ORIGIN=http://localhost:3000

RUN_SEED=true

PORTAL_REQUEST_TIMEOUT_MS=30000
PORTAL_CONNECT_TIMEOUT_MS=10000
PORTAL_MAX_RETRIES=3
PORTAL_RETRY_BASE_DELAY_MS=1000
PORTAL_RETRY_MAX_DELAY_MS=15000
PORTAL_MAX_CONCURRENCY=2
PORTAL_MIN_INTERVAL_MS=1000
PORTAL_CACHE_ENABLED=true
PORTAL_CACHE_TTL_SECONDS=3600

COLLECTION_CONCURRENCY=2
COLLECTION_POLL_INTERVAL_MS=5000
COLLECTION_WORKER_ENABLED=true

# Fora do Docker (host):
# DATABASE_URL=postgresql://observatorio:observatorio123@localhost:5433/observatorio
# REDIS_URL=redis://localhost:6379
# DEV_API_PROXY_TARGET=http://127.0.0.1:3001
